# LinkProof Configuration Example
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-string
DATABASE_PATH=data/linkproof.db
PUBLISHER_KEY_DIR=data/publisher_keys

# Network & Redirect Security Limits
MAX_REDIRECT_HOPS=10
HTTP_TIMEOUT_SECONDS=5
MAX_RESPONSE_BYTES=524288
BLOCK_PRIVATE_IPS=True

# Threat Intelligence (Google Safe Browsing API v4)
# Obtain an API key from Google Cloud Console (APIs & Services -> Enable 'Safe Browsing API')
GOOGLE_SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT_SECONDS=4.0

